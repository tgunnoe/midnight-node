+/// Try to load cargo metadata from a pre-generated JSON file.
+/// This is useful for sandboxed builds (like Nix with crate2nix) where
+/// `cargo metadata` cannot fetch dependencies from the network.
+///
+/// Set `WASM_BUILD_METADATA_PATH` to the path of a JSON file containing
+/// the output of `cargo metadata --format-version 1`.
+fn try_load_metadata_from_file() -> Option<Metadata> {
+	let metadata_path = env::var("WASM_BUILD_METADATA_PATH").ok()?;
+	println!("cargo:rerun-if-env-changed=WASM_BUILD_METADATA_PATH");
+
+	let metadata_json = match fs::read_to_string(&metadata_path) {
+		Ok(json) => json,
+		Err(e) => {
+			eprintln!("Warning: Failed to read metadata from {}: {}", metadata_path, e);
+			return None;
+		}
+	};
+
+	serde_json::from_str(&metadata_json)
+		.map_err(|e| eprintln!("Warning: Failed to parse metadata JSON: {}", e))
+		.ok()
+}
+
+/// Get an override for the workspace root path from environment.
+/// This is needed for sandboxed builds where the workspace_root in cargo metadata
+/// points to a path that doesn't exist in the build environment.
+///
+/// Set `WASM_BUILD_WORKSPACE_ROOT` to the actual workspace root path.
+fn get_workspace_root_override() -> Option<PathBuf> {
+	let workspace_root = env::var("WASM_BUILD_WORKSPACE_ROOT").ok()?;
+	println!("cargo:rerun-if-env-changed=WASM_BUILD_WORKSPACE_ROOT");
+	let path = PathBuf::from(&workspace_root);
+	if path.exists() {
+		Some(path)
+	} else {
+		eprintln!("Warning: WASM_BUILD_WORKSPACE_ROOT path does not exist: {}", workspace_root);
+		None
+	}
+}
